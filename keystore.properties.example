# Copy this file to `keystore.properties` and fill in your own values to sign
# release builds with a fixed key. `keystore.properties` is gitignored and must
# NEVER be committed. If this file is absent, builds fall back to Android's
# default debug signing automatically.
#
# Generate your own key once with:
#   keytool -genkeypair -v -keystore theftguard.keystore \
#     -alias theftguard -keyalg RSA -keysize 2048 -validity 10000
#
# In CI, provide the same values as the environment variables shown in the
# comments instead of this file (see .github/workflows/build-apk.yml).

storeFile=theftguard.keystore      # env: KEYSTORE_FILE
storePassword=changeme             # env: KEYSTORE_PASSWORD
keyAlias=theftguard                # env: KEY_ALIAS
keyPassword=changeme               # env: KEY_PASSWORD
